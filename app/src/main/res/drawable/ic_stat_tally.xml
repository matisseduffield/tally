<!-- Notification icon: the launcher's tally mark in white, cropped to the
     marks (the launcher's 108 grid, from 20 to 88) so it fills the status bar
     icon with about 1dp to spare. Same strokes and the same cut around the
     fifth stroke. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="68"
    android:viewportHeight="68">
    <group
        android:translateX="-20"
        android:translateY="-20">
        <group>
            <clip-path android:pathData="M0,0H108V20.23L0,72.23ZM0,108H108V35.77L0,87.77Z" />
            <path
                android:pathData="M36,33V75M48,33V75M60,33V75M72,33V75"
                android:strokeColor="#FFFFFFFF"
                android:strokeWidth="7.6"
                android:strokeLineCap="round"
                android:strokeLineJoin="round" />
        </group>
        <path
            android:pathData="M27,67L81,41"
            android:strokeColor="#FFFFFFFF"
            android:strokeWidth="7.6"
            android:strokeLineCap="round"
            android:strokeLineJoin="round" />
    </group>
</vector>
